// ==============================================================================
// NETRA Data Model - Phase 1 Foundation
// Company: Astraveda Defence
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Verification model for metadata and environment testing
model SystemMetadata {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_metadata")
}

/// Authentication & User Session Foundation
model User {
  id             String    @id @default(uuid())
  callsign       String    @unique
  email          String?   @unique
  passwordHash   String    @map("password_hash")
  role           String    @default("OPERATOR") // ADMIN, ANALYST, OPERATOR, VIEWER
  clearanceLevel String    @default("SECRET") @map("clearance_level")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  sessions       Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Future Production Event Model
model OperationalEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  timestamp   DateTime
  type        String
  severity    String
  confidence  Int
  riskScore   Int      @map("risk_score")
  latitude    Float?
  longitude   Float?
  sector      String?
  assessment  String?
  isSynthetic Boolean  @default(false) @map("is_synthetic")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("operational_events")
}

/// Future Production Entity Model
model OperationalEntity {
  id           String   @id @default(uuid())
  entityId     String   @unique @map("entity_id")
  name         String
  type         String
  status       String
  riskScore    Int      @map("risk_score")
  anomalyScore Int      @map("anomaly_score")
  confidence   Int
  observations Int      @default(0)
  assessment   String?
  isSynthetic  Boolean  @default(false) @map("is_synthetic")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("operational_entities")
}

/// Future Production Alert Model
model OperationalAlert {
  id          String   @id @default(uuid())
  alertId     String   @unique @map("alert_id")
  severity    String
  title       String
  description String
  confidence  Int
  riskScore   Int      @map("risk_score")
  status      String   @default("NEW")
  isSynthetic Boolean  @default(false) @map("is_synthetic")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("operational_alerts")
}

/// Future Production Evidence Model
model OperationalEvidence {
  id          String   @id @default(uuid())
  evidenceId  String   @unique @map("evidence_id")
  source      String
  type        String
  relationship String
  confidence  Int
  reliability String
  summary     String
  isSynthetic Boolean  @default(false) @map("is_synthetic")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("operational_evidence")
}
