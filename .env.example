# ==============================================================================
# NETRA Platform - Environment Configuration Template
# Company: Astraveda Defence
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC VALUES.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Server Environment (development | test | staging | production)
NODE_ENV=development

# Backend API Configuration
PORT=5000
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (PostgreSQL with Prisma)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://netra_user:secure_password_here@localhost:5432/netra_db?schema=public

# Log Level (error | warn | info | http | debug)
LOG_LEVEL=info

# Frontend Client API URL (Used by web app during production or build)
VITE_API_URL=http://localhost:5000/api/v1
